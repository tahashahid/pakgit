{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "pakgit": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src/renderer",
      "prefix": "pg",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/renderer/main.ts",
            "index": "src/renderer/index.html",
            "tsConfig": "tsconfig.app.json",
            "outputPath": {
              "base": "out/renderer",
              "browser": ""
            },
            "baseHref": "./",
            "assets": [
              {
                "glob": "**/*",
                "input": "src/renderer/public"
              }
            ],
            "styles": [
              "src/renderer/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1MB",
                  "maximumError": "2MB"
                }
              ],
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 4200
          },
          "configurations": {
            "development": {
              "buildTarget": "pakgit:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
