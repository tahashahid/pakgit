{
  "name": "pakgit",
  "version": "0.1.0",
  "description": "PakGit - a cross-platform Git client for Windows, macOS and Linux",
  "main": "./out/main/index.js",
  "author": "Taha Shahid",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n ng,electron \"ng serve\" \"wait-on http://localhost:4200 && electron-vite build && cross-env ELECTRON_RENDERER_URL=http://localhost:4200 electron .\"",
    "build": "ng build && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && ng build --configuration development",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "test:backend": "esbuild src/main/git.ts --bundle --platform=node --format=cjs --alias:@shared=./src/shared --outfile=out/test/git.cjs --log-level=error && node test/git-backend.test.cjs",
    "build:renderer": "ng build"
  },
  "dependencies": {
    "chokidar": "^4.0.1",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "typescript": "~6.0.2",
    "esbuild": "^0.24.0",
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "concurrently": "^9.1.0",
    "wait-on": "^8.0.1",
    "cross-env": "^7.0.3"
  }
}
