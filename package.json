{
  "name": "pakgit",
  "version": "0.1.0",
  "description": "PakGit - a cross-platform Git client for Windows, macOS and Linux",
  "main": "./out/main/index.js",
  "author": "Taha Shahid",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "test:backend": "esbuild src/main/git.ts --bundle --platform=node --format=cjs --alias:@shared=./src/shared --outfile=out/test/git.cjs --log-level=error && node test/git-backend.test.cjs"
  },
  "dependencies": {
    "chokidar": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.1",
    "esbuild": "^0.24.0"
  }
}
